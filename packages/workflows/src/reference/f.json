{
  "trigger": {"app:record": {"resource": "leads"}},
  "stateMachine": {
    "QueryLanguage": "JSONata",
    "StartAt": "PostToSlack",
    "States": {
      "PostToSlack": {
        "Type": "Task",
        "Resource": "app:piece",
        "Arguments": {
          "piece": "slack",
          "action": "send_channel_message",
          "connection": "sales_slack",
          "props": {
            "channel": "C0SALES01",
            "text": "{% 'New lead: ' & $states.context.Execution.Input.record.name & ' from ' & $states.context.Execution.Input.record.company & ' (' & $states.context.Execution.Input.record.email & ')' %}"
          }
        },
        "Assign": {
          "slackMessage": "{% $states.result %}"
        },
        "Next": "SaveTs"
      },
      "SaveTs": {
        "Type": "Task",
        "Resource": "app:records.update",
        "Arguments": {
          "resource": "leads",
          "key": "{% $states.context.Execution.Input.record.id %}",
          "data": {
            "slack_ts": "{% $slackMessage.ts %}"
          }
        },
        "End": true
      }
    }
  }
}
