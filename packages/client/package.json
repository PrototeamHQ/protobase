{
  "name": "@protobase/client",
  "version": "0.1.2",
  "description": "Typed fetch client for the Protobase REST API.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PrototeamHQ/protobase.git",
    "directory": "packages/client"
  },
  "homepage": "https://docs.protobase.net",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "tsdown"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js"
    },
    "types": "./dist/index.d.ts"
  },
  "dependencies": {
    "@protobase/layout": "workspace:*",
    "@protobase/schema": "workspace:*",
    "better-auth": "^1.7.7"
  }
}
