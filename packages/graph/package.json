{
  "name": "@protobase/graph",
  "version": "0.14.2",
  "description": "A layout block plugin that draws records as nodes and edges, grouped and coloured by status.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PrototeamHQ/protobase.git",
    "directory": "packages/graph"
  },
  "homepage": "https://docs.protobase.net",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
