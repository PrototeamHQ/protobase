{
  "name": "@protobase/layout",
  "version": "0.1.0",
  "description": "Composed pages for Protobase, written as JSX that compiles to plain data, with its JSX runtime.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PrototeamHQ/protobase.git",
    "directory": "packages/layout"
  },
  "homepage": "https://docs.protobase.net",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./jsx-runtime": "./src/jsx-runtime.ts",
    "./jsx-dev-runtime": "./src/jsx-dev-runtime.ts"
  },
  "types": "./src/index.ts",
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.stories.tsx",
    "!src/testing"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@protobase/schema": "workspace:*",
    "aip-parsers": "^1.0.0"
  }
}
