{
  "name": "@protobase/layout",
  "version": "0.1.5",
  "description": "Composed pages for Protobase, written as JSX that compiles to plain data, with its JSX runtime.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PrototeamHQ/protobase.git",
    "directory": "packages/layout"
  },
  "homepage": "https://docs.protobase.net",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./jsx-runtime": "./src/jsx-runtime.ts",
    "./jsx-dev-runtime": "./src/jsx-dev-runtime.ts"
  },
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "tsdown"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js",
      "./jsx-runtime": "./dist/jsx-runtime.js",
      "./jsx-dev-runtime": "./dist/jsx-dev-runtime.js"
    },
    "types": "./dist/index.d.ts"
  },
  "dependencies": {
    "@protobase/schema": "workspace:*",
    "aip-parsers": "^1.0.0"
  }
}
