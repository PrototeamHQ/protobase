{
  "name": "@protobase/server",
  "version": "0.4.0",
  "description": "The Protobase REST API as a Hono app, with Better Auth sign-in.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PrototeamHQ/protobase.git",
    "directory": "packages/server"
  },
  "homepage": "https://docs.protobase.net",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "tsdown"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js"
    },
    "types": "./dist/index.d.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.7",
    "@protobase/layout": "workspace:*",
    "@protobase/query": "workspace:*",
    "@protobase/schema": "workspace:*",
    "@scalar/hono-api-reference": "^0.12.10",
    "better-auth": "^1.7.7",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "kysely": "^0.29.6",
    "nodemailer": "^10.0.16",
    "zod": "^4.6.5"
  }
}
