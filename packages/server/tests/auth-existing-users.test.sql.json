  "Better Auth on an existing users table > plans its other tables next to it, signs in a bcrypt password and stores it again as scrypt, and adds users there": {
    "Better Auth on an existing users table > plans its other tables next to it, signs in a bcrypt password and stores it again as scrypt, and adds users there#0": [
      {"sql":"\n  create schema auth;\n  create table auth.users (\n    id uuid primary key,\n    aud varchar(255),\n    role varchar(255),\n    email varchar(255),\n    encrypted_password varchar(255),\n    email_confirmed_at timestamptz,\n    raw_user_meta_data jsonb,\n    created_at timestamptz,\n    updated_at timestamptz,\n    name text,\n    email_verified boolean,\n    image text,\n    app_role text,\n    banned boolean,\n    ban_reason text,\n    ban_expires timestamptz\n  );\n  create table public.profiles (id uuid primary key references auth.users (id), full_name text);\n  create function auth.add_profile() returns trigger language plpgsql as $$\n  begin\n    insert into public.profiles (id, full_name) values (new.id, new.raw_user_meta_data->>'full_name');\n    return new;\n  end $$;\n  create trigger on_user_created after insert on auth.users for each row execute function auth.add_profile();\n  insert into auth.users (id, aud, role, email, encrypted_password, email_confirmed_at, created_at, updated_at, name, email_verified, app_role)\n    values ('6f1c2a52-3c1e-4c39-9d0e-2f0b8f6c1a11', 'authenticated', 'authenticated', 'alice@example.com', '$2a$10$53.u43/FyEHc8FW9OatxRuMKN/jTeIXc87zG6LOnKaq5XJfrnYMa.', '2026-07-01', '2026-07-01', '2026-07-01', 'Alice', true, 'admin');\n","result":[{"command":"CREATE","rowCount":null,"columns":[],"rows":[]},{"command":"CREATE","rowCount":null,"columns":[],"rows":[]},{"command":"CREATE","rowCount":null,"columns":[],"rows":[]},{"command":"CREATE","rowCount":null,"columns":[],"rows":[]},{"command":"CREATE","rowCount":null,"columns":[],"rows":[]},{"command":"INSERT","rowCount":1,"columns":[],"rows":[]}]},
