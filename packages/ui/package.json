{
  "name": "@protobase/ui",
  "version": "0.14.2",
  "description": "The Protobase admin app and the React hooks and components for custom UI.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PrototeamHQ/protobase.git",
    "directory": "packages/ui"
  },
  "homepage": "https://docs.protobase.net",
  "type": "module",
  "protobase": {
    "pluginApi": 1
  },
  "sideEffects": [
    "*.css",
    "./dist/app/main.js"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./theme.css": "./src/theme.css",
    "./styles.css": "./src/styles.css"
  },
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && protobase build-shell dist/shell --source-maps dist/shell-source-maps",
    "prepack": "tsdown && protobase build-shell dist/shell --source-maps dist/shell-source-maps"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js",
      "./theme.css": "./dist/theme.css",
      "./styles.css": "./dist/styles.css"
    },
    "types": "./dist/index.d.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@protobase/client": "workspace:*",
    "@protobase/layout": "workspace:*",
    "@protobase/schema": "workspace:*",
    "@sentry/browser": "^11.7.0",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-table": "^9.2.6",
    "altcha-lib": "^2.6.0",
    "dompurify": "^3.4.17",
    "fflate": "^0.8.3",
    "lucide-react": "^1.52.0",
    "maplibre-gl": "^6.14.0",
    "marked": "^18.1.1",
    "pmtiles": "^4.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-map-gl": "^8.1.3",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "thumbhash": "^0.1.1",
    "uqr": "^0.1.3"
  }
}
