{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["packages", "test-support", "tests", ".storybook", "examples", "docs-examples", "scripts/test-db", "scripts/release-speed", "vitest.config.ts"],
  "exclude": ["packages/*/dist", "packages/cli/tests/supabase/fixtures/edge-functions"]
}
