{
  "name": "property-portal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:migrate": "bun db/migrate.ts",
    "db:seed": "bun seed/cli.ts",
    "db:reset": "bun db/drop.ts && bun db/migrate.ts && bun seed/cli.ts --scale small",
    "map:tiles": "bun map/tiles.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "protobase": "protobase",
    "build": "protobase build",
    "serve": "protobase build && protobase serve dist",
    "dev": "protobase dev"
  },
  "dependencies": {
    "@protobase/cli": "workspace:*",
    "@protobase/layout": "workspace:*",
    "@protobase/schema": "workspace:*",
    "@protobase/server": "workspace:*",
    "@protobase/ui": "workspace:*",
    "better-auth": "^1.7.7",
    "kysely": "^0.29.6",
    "pg": "^8.23.1",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
