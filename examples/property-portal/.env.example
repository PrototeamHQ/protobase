# The property portal example's own settings. The nearest .env wins, so this file, not the repository's, is the one
# `protobase dev`, `protobase serve` and the db:* scripts read here. The Postgres container is the repository's (`bun run db:up`).
DATABASE_URL=postgres://protobase:protobase@localhost:55432/property_portal

# Admin store (Better Auth users, sessions, signing keys): the `auth` schema of DATABASE_URL, created by `db:migrate`.
BETTER_AUTH_URL=http://localhost:5173
# Signs cookies and encrypts the token keys. Generate your own: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
# TRUSTED_ORIGINS=

# Search alert mail: the SMTP server and the sender. Without them alerts still show in the app, and nothing is mailed.
# PROTOBASE_SMTP_URL=smtp://localhost:1025
# PROTOBASE_MAIL_FROM=alerts@portal.example.com

# The listing page's map: a MapLibre style URL. This one is `bun run map:tiles`, the development tiles (the Benelux and
# the British Isles in detail). Point it at your own self-hosted style and PMTiles; without it the app draws no map.
PROTOBASE_MAP_STYLE_URL=http://localhost:8790/style.json
