# The ERP's own settings. The nearest .env wins, so this file, not the repository's, is the one `protobase dev`,
# `protobase serve` and the db:* scripts read here. The Postgres container is the repository's (`bun run db:up`).
DATABASE_URL=postgres://protobase:protobase@localhost:55432/protobase

# Admin store (Better Auth users, sessions, signing keys): the `auth` schema of DATABASE_URL, created by `bun run auth:migrate`.
# Set ADMIN_DATABASE_URL only to keep that schema in another database.
# ADMIN_DATABASE_URL=postgres://protobase:protobase@localhost:55432/protobase
# Public URL of the API, for cookies and as the issuer of the login tokens (use the https tunnel URL when tunnelling).
BETTER_AUTH_URL=http://localhost:5173
# Signs cookies and encrypts the token keys. Generate your own: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
# Extra comma separated origins allowed to call the auth endpoints (https://*.trycloudflare.com is always trusted).
# TRUSTED_ORIGINS=
# Mail for password reset and emailed sign-in and two-factor codes: the SMTP server (smtp:// with STARTTLS, or smtps://) and the sender. Without them those are off.
# PROTOBASE_SMTP_URL=smtp://user:password@localhost:1025
# PROTOBASE_MAIL_FROM=noreply@example.com
