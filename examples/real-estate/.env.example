# The real estate example's own settings. The nearest .env wins, so this file, not the repository's, is the one
# `protobase dev`, `protobase serve` and the db:* scripts read here. The Postgres container is the repository's (`bun run db:up`).
DATABASE_URL=postgres://protobase:protobase@localhost:55432/real_estate

# Admin store (Better Auth users, sessions, signing keys): the `auth` schema of DATABASE_URL, created by `bun run auth:migrate`.
# ADMIN_DATABASE_URL=postgres://protobase:protobase@localhost:55432/real_estate
BETTER_AUTH_URL=http://localhost:5173
# Signs cookies and encrypts the token keys. Generate your own: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
# TRUSTED_ORIGINS=
