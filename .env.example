POSTGRES_USER=protobase
POSTGRES_PASSWORD=protobase
POSTGRES_DB=protobase
POSTGRES_PORT=55432
# PgBouncer in transaction mode in front of it, as the cloud runs it; the jobs integration tests go through it.
PGBOUNCER_PORT=55442
# Supabase's Postgres image, which `bun run test:record` records the Supabase import's snapshot tests on.
SUPABASE_POSTGRES_PORT=55433
DATABASE_URL=postgres://protobase:protobase@localhost:55432/protobase

# Admin store (Better Auth users, sessions, signing keys): the `auth` schema of DATABASE_URL, created by `bun run --cwd examples/erp db:migrate`.
# Public URL of the API, for cookies and as the issuer of the login tokens (use the https tunnel URL when tunnelling).
PROTOBASE_URL=http://localhost:5173
# Signs cookies and encrypts the token keys. Generate your own: openssl rand -base64 32
PROTOBASE_SECRET=change-me-generate-with-openssl-rand-base64-32
# Extra comma separated origins allowed to call the auth endpoints (a dev tunnel needs its exact host here, such as https://my-tunnel.trycloudflare.com).
# PROTOBASE_TRUSTED_ORIGINS=
# Mail for password reset and emailed sign-in and two-factor codes: the SMTP server (smtp:// with STARTTLS, or smtps://) and the sender. Without them those are off.
# PROTOBASE_SMTP_URL=smtp://user:password@localhost:1025
# PROTOBASE_MAIL_FROM=noreply@example.com
# Error reporting: the DSN of a Sentry-compatible tracker (Sentry, Bugsink, GlitchTip) the app's errors go to. Without it nothing is sent.
# PROTOBASE_SENTRY_DSN=https://key@errors.example.com/1
