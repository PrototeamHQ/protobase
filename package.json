{
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare": "bun scripts/install-git-hooks.mjs",
    "db:up": "test -f .env || cp .env.example .env; docker compose up -d --wait && bun scripts/local-databases.mjs",
    "db:down": "docker compose down",
    "test": "vitest run --project unit --project pglite",
    "test:integration": "vitest run --project 'integration*'",
    "test:smoke": "vitest run --project integration tests/smoke",
    "test:presets": "vitest run --project presets",
    "presets:write": "bun packages/presets/src/build.ts",
    "images:context": "bun scripts/image-contexts.mjs",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest --project unit --project pglite",
    "test:db": "bun scripts/test-db/build.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun run --filter './packages/*' build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check:boundaries": "depcruise packages test-support tests examples docs-examples .storybook --config .dependency-cruiser.cjs",
    "check": "bun run typecheck && bun run test && bun run test:integration && bun run check:boundaries",
    "screenshots": "storybook build && bun scripts/screenshots.mjs",
    "protobase": "protobase",
    "build:serve": "protobase build-serve",
    "screenshots:live": "storybook build && bun scripts/screenshots.mjs --live",
    "test:stories": "storybook build && bun scripts/play-tests.mjs",
    "docs:dev": "bun run --cwd website dev",
    "docs:build": "bun run build-storybook && bun run --cwd website build && cp -R storybook-static website/dist/storybook",
    "docs:check": "bun scripts/check-docs.mjs",
    "release": "bun scripts/release.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@electric-sql/pglite": "^0.5.8",
    "@protobase/cli": "workspace:*",
    "@protobase/layout": "workspace:*",
    "@protobase/query": "workspace:*",
    "@protobase/schema": "workspace:*",
    "@protobase/server": "workspace:*",
    "@seriousme/openapi-schema-validator": "^2.11.0",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/smtp-server": "^3.5.13",
    "@vitejs/plugin-react": "^6.1.2",
    "better-auth": "^1.7.7",
    "commit-and-tag-version": "^13.2.1",
    "dependency-cruiser": "^18.5.0",
    "jose": "^6.2.12",
    "kysely": "^0.29.6",
    "kysely-pglite-dialect": "^1.3.1",
    "playwright": "^1.63.0",
    "postgres": "^3.4.9",
    "smtp-server": "^3.19.18",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  },
  "workspaces": [
    "packages/*",
    "examples/*",
    "website"
  ]
}
